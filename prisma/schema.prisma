generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum Status {
  Applied
  Shortlisted
  Interviewed
  Offered
  Rejected
}

enum JobType {
  FullTime
  PartTime
  Contract
  Internship
  Freelance
}

enum JobMode {
  Remote
  OnSite
  Hybrid
}

enum PayFrequency {
  Hourly
  Weekly
  Monthly
  Yearly
}

enum Role {
  User
  Admin
}

enum DegreeType {
  HighSchool
  Diploma
  Associate
  Bachelor
  Master
  Doctorate
}

enum ProficiencyLevel {
  Beginner
  Intermediate
  Advanced
  Expert
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  username        String   @unique
  firstName       String?
  lastName        String?
  password        String
  role            Role     @default(User)
  credits         Int      @default(0)
  jobApplications JobApplication[]
  preferredCurrency String?  @default("$")
  userDetails     UserDetails?
  resume          Resume?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  softDeleted     Boolean  @default(false)
}

model UserDetails {
  userId    String   @id @unique
  user      User     @relation(fields: [userId], references: [id])
  bio       String?
  contact_number String?
  addr_line1 String?
  addr_line2 String?
  city       String?
  state      String?
  country    String?
  zip_code   String?
  personal_website_url String?
  linkedin_url String?
  portfolio_url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  softDeleted Boolean @default(false)
}

model JobApplication {
  id                           String         @id @default(uuid())
  company                      String
  position                     String
  location                     String
  jobType                      JobType
  jobMode                      JobMode
  minPay                       Float?
  maxPay                       Float?
  payFrequency                 PayFrequency?
  status                       Status
  appliedDate                  DateTime?
  latestUpdate                 DateTime?
  latestInterviewScheduledDate DateTime?
  interviews                   Interview[]
  jobDescription               JobDescription?
  referenceLink                String?
  notes                        String?
  userId                       String
  user                         User          @relation(fields: [userId], references: [id])
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  softDeleted                  Boolean       @default(false)
}

model JobDescription {
  id          String   @id @default(uuid())
  jobId       String   @unique
  job         JobApplication @relation(fields: [jobId], references: [id])
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  softDeleted  Boolean   @default(false)
}

model Interview {
  id          String   @id @default(uuid())
  jobId       String
  job         JobApplication @relation(fields: [jobId], references: [id])
  interviewIdx Int
  interviewDate DateTime
  interviewLocation String
  interviewerName String?
  interviewerContact String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  softDeleted Boolean   @default(false)
}

model Resume {
  id       String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  details ResumeDetails?
  experiences ResumeExperience[]
  educations ResumeEducation[]
  projects ResumeProjects[]
  skills ResumeSkills[]
  certifications ResumeCertifications[]
  fileReferenceLink String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  softDeleted Boolean @default(false)
}

model ResumeDetails {
  id          String   @id @default(uuid())
  resumeId    String   @unique
  resume      Resume   @relation(fields: [resumeId], references: [id])
  role         String?
  bio         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  softDeleted Boolean @default(false)
}

model ResumeExperience {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id])
  company     String
  position    String
  location    String
  jobType     JobType
  jobMode     JobMode
  lastSalary  Float?
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  softDeleted Boolean  @default(false)
}

model ResumeEducation {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id])
  institution String
  degree      DegreeType
  fieldOfStudy String
  gpa         Float?
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  softDeleted Boolean  @default(false)
}

model ResumeProjects {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id])
  name        String
  description String?
  link        String?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  softDeleted Boolean  @default(false)
}

model ResumeSkills {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id])
  skill       String
  proficiency ProficiencyLevel?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  softDeleted Boolean  @default(false)
}

model ResumeCertifications {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id])
  name        String
  issuingOrganization String
  issueDate   DateTime
  expirationDate DateTime?
  credentialId String?
  credentialUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  softDeleted Boolean  @default(false)
}